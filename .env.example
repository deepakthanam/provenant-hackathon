# Core
NODE_ENV=development
PORT=4000
CONSOLE_PORT=3000
DEMO_STORE_PORT=4100
# Port 5433 (not 5432) so the embedded Postgres never collides with a locally installed one.
DATABASE_URL=postgres://provenant:provenant@localhost:5433/provenant
# auto = use DATABASE_URL if reachable, else start embedded Postgres 16 (no Docker needed)
# embedded = always embedded | external = never start one (Docker Compose, Render, …)
DATABASE_MODE=auto
PUBLIC_BASE_URL=http://localhost:4000
CONSOLE_PUBLIC_URL=http://localhost:3000
CONSOLE_PASSWORD=                   # set on deployments: HTTP Basic password for the console (any username)
DEMO_STORE_URL=http://localhost:4100

# PayPal
PAYPAL_MODE=mock                    # mock | sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=                  # from the Developer Dashboard, needed for signature verification
PAYPAL_BN_CODE=                     # partner attribution, optional
DISPUTE_POLL_INTERVAL_SEC=60        # fallback when no tunnel is running
PAYPAL_SANDBOX_BUYER_EMAIL=         # sandbox personal account, for sandbox dispute creation (limited release)
MOCK_PAYPAL_WEBHOOKS=true           # mock mode: deliver webhooks; false = exercise the polling fallback

# Signing keys (generate with `pnpm keygen`)
PROVENANT_SIGNING_PRIVATE_KEY=      # Ed25519, PEM, base64-encoded
PROVENANT_SIGNING_PUBLIC_KEY=

# LLM
LLM_PROVIDER=mock                   # mock | anthropic | bedrock
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
AWS_REGION=
BEDROCK_MODEL_ID=

# Adjudication
AUTO_ACTION=false                   # false = recommend only; merchant approves every action
CONFIDENCE_THRESHOLD=0.75
SHARED_FAULT_REFUND_PCT=50

# API keys (generated by `pnpm bootstrap`; the server seeds their hashes on start)
PROVENANT_ADMIN_API_KEY=            # console / operator
PROVENANT_PLATFORM_API_KEY=         # demo-agent platform (SDK)
PROVENANT_MERCHANT_API_KEY=         # demo-store merchant
