                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paypal_order_id\": \"{{orderId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/bundles/{{bundleId}}/seal",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "bundles",
                "{{bundleId}}",
                "seal"
              ]
            }
          }
        },
        {
          "name": "Mock buyer approves",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
