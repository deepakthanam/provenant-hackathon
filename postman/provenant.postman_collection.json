              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"captureId\", pm.response.json().purchase_units[0].payments.captures[0].id);"
                ]
