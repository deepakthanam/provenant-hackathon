              "raw": "{\n  \"merchant_id\": \"demo-store\",\n  \"url\": \"http://localhost:4100/p/RUN-BLK-10\",\n  \"title\": \"Trail runner, black\",\n  \"attributes\": {\n    \"color\": \"black\",\n    \"size\": \"10\",\n    \"style\": \"trail\"\n  },\n  \"price\": {\n    \"value\": \"84.00\",\n    \"currency\": \"USD\"\n  },\n  \"delivery_promise\": {\n    \"min_days\": 3,\n    \"max_days\": 5\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/bundles/{{bundleId}}/offer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "bundles",
                "{{bundleId}}",
                "offer"
              ]
            }
          }
        },
        {
          "name": "Record decision",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{platformKey}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"step\": \"compared_offers\",\n  \"detail\": \"Postman run: 1 candidate\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/bundles/{{bundleId}}/decision",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "bundles",
                "{{bundleId}}",
                "decision"
              ]
            }
          }
        },
        {
          "name": "Set cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{platformKey}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cart\": [\n    {\n      \"sku\": \"RUN-BLK-10\",\n      \"name\": \"Trail runner\",\n      \"qty\": 1,\n      \"unit_price\": {\n        \"value\": \"84.00\",\n        \"currency\": \"USD\"\n      },\n      \"category\": \"footwear\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/bundles/{{bundleId}}/cart",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "bundles",
                "{{bundleId}}",
                "cart"
              ]
            }
          }
        },
        {
          "name": "Prepare order (custom_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"custom_id is the bundle id\", () => pm.expect(pm.response.json().custom_id).to.eql(pm.collectionVariables.get(\"bundleId\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{platformKey}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/bundles/{{bundleId}}/prepare-order",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "bundles",
                "{{bundleId}}",
                "prepare-order"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. PayPal checkout (mock PayPal, same paths as the real API)",
      "item": [
        {
          "name": "OAuth token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"paypalToken\", pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{paypalBase}}/v1/oauth2/token",
              "host": [
                "{{paypalBase}}"
              ],
              "path": [
                "v1",
                "oauth2",
                "token"
              ]
            }
          }
        },
        {
          "name": "Create order with custom_id",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.headers.upsert({ key: \"PayPal-Request-Id\", value: pm.variables.replaceIn(\"{{$guid}}\") });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const o = pm.response.json();",
                  "pm.collectionVariables.set(\"orderId\", o.id);",
                  "pm.test(\"custom_id set\", () => pm.expect(o.purchase_units[0].custom_id).to.eql(pm.collectionVariables.get(\"bundleId\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{paypalToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"intent\": \"CAPTURE\",\n  \"purchase_units\": [\n    {\n      \"reference_id\": \"default\",\n      \"custom_id\": \"{{bundleId}}\",\n      \"amount\": {\n        \"currency_code\": \"USD\",\n        \"value\": \"84.00\"\n      }\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{paypalBase}}/v2/checkout/orders",
              "host": [
                "{{paypalBase}}"
              ],
              "path": [
                "v2",
                "checkout",
                "orders"
              ]
            }
          }
        },
        {
          "name": "Seal bundle to the order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"SEALED\", () => pm.expect(pm.response.json().status).to.eql(\"SEALED\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{platformKey}}",
                  "type": "string"
