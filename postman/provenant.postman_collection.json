            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{paypalBase}}/_buyer/orders/{{orderId}}/approve",
              "host": [
                "{{paypalBase}}"
              ],
              "path": [
                "_buyer",
                "orders",
                "{{orderId}}",
                "approve"
              ]
