{
  "info": {
    "name": "Provenant (mock mode)",
    "description": "Main flow end to end against a local Provenant in mock PayPal mode: signed mandate → evidence bundle → PayPal order with custom_id → capture → delivery → dispute → verdict → approved provide-evidence → sandbox settlement. Run: `pnpm postman` (generates the environment from .env and runs Newman).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "userRef",
      "value": ""
    },
    {
      "key": "expiresAt",
      "value": ""
    },
    {
      "key": "userSig",
      "value": ""
    },
    {
      "key": "userPub",
      "value": ""
    },
    {
      "key": "bundleId",
      "value": ""
    },
    {
      "key": "paypalToken",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "captureId",
      "value": ""
    },
    {
      "key": "disputeId",
      "value": ""
    },
    {
      "key": "now",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Setup",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"userRef\", \"usr_postman\" + Date.now());",
                  "pm.collectionVariables.set(\"expiresAt\", new Date(Date.now() + 7 * 864e5).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"db ok\", () => pm.expect(pm.response.json().db).to.eql(\"ok\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            }
          }
        },
        {
          "name": "Dev: sign the mandate as a demo user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set(\"userSig\", r.user_sig);",
                  "pm.collectionVariables.set(\"userPub\", r.user_public_key);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{platformKey}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_ref\": \"{{userRef}}\",\n  \"mandate\": {\n    \"text\": \"Buy black running shoes, size 10, under $90.\",\n    \"max_amount\": {\n      \"value\": \"90.00\",\n      \"currency\": \"USD\"\n    },\n    \"confirm_above\": null,\n    \"allowed_categories\": [\n      \"footwear\"\n    ],\n    \"allowed_merchants\": [\n      \"demo-store\"\n    ],\n    \"expires_at\": \"{{expiresAt}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/dev/demo-user/sign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dev",
                "demo-user",
                "sign"
              ]
            },
            "description": "Mock/dev only. Postman cannot sign Ed25519; the server signs as a demo user (in production the user’s device signs)."
          }
        }
      ]
    },
    {
      "name": "2. Agent records evidence",
      "item": [
        {
          "name": "Create bundle from signed mandate",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"OPEN\", () => pm.expect(b.status).to.eql(\"OPEN\"));",
                  "pm.collectionVariables.set(\"bundleId\", b.bundle_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{platformKey}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_ref\": \"{{userRef}}\",\n  \"user_public_key\": \"{{userPub}}\",\n  \"agent_version\": \"postman\",\n  \"intent_mandate\": {\n    \"text\": \"Buy black running shoes, size 10, under $90.\",\n    \"max_amount\": {\n      \"value\": \"90.00\",\n      \"currency\": \"USD\"\n    },\n    \"confirm_above\": null,\n    \"allowed_categories\": [\n      \"footwear\"\n    ],\n    \"allowed_merchants\": [\n      \"demo-store\"\n    ],\n    \"expires_at\": \"{{expiresAt}}\",\n    \"user_sig\": \"{{userSig}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/bundles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "bundles"
              ]
            }
          }
        },
        {
          "name": "Record offer snapshot",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{platformKey}}",
                  "type": "string"
                }
